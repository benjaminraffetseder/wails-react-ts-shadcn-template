package main

import "{{.ModulePath}}/internal/buildinfo"

// App is a Wails service exposed to the frontend through generated bindings.
type App struct{}

type AppInfo struct {
	Version string `json:"version"`
}

func (a *App) GetInfo() AppInfo {
	return AppInfo{Version: buildinfo.Version()}
}

func NewApp() *App {
	return &App{}
}
