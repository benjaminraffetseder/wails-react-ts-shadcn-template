package main

import "strings"

// App is a Wails service exposed to the frontend through generated bindings.
type App struct{}

func NewApp() *App {
	return &App{}
}

// Greeting carries data; the frontend owns localized messages.
type Greeting struct {
	Name string `json:"name"`
}

// Greet demonstrates a typed frontend-to-Go call. Replace it with your app's API.
func (a *App) Greet(name string) Greeting {
	return Greeting{Name: strings.TrimSpace(name)}
}
