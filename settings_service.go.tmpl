package main

import (
	"path/filepath"

	"{{.ModulePath}}/internal/apppaths"
	"{{.ModulePath}}/internal/preferences"
)

type SettingsService struct {
	store   *preferences.Store
	publish func(preferences.Settings)
}

func NewSettingsService() *SettingsService {
	return &SettingsService{store: preferences.New(func() (string, error) {
		dir, err := apppaths.ConfigDir()
		return filepath.Join(dir, "settings.json"), err
	})}
}

// GetSettings loads preferences, creating persisted defaults on first launch.
func (s *SettingsService) GetSettings() (preferences.Settings, error) { return s.store.Get() }

func (s *SettingsService) UpdateSettings(patch preferences.Patch) (preferences.Settings, error) {
	return s.changed(s.store.Update(patch))
}

func (s *SettingsService) ResetSettings() (preferences.Settings, error) {
	return s.changed(s.store.Reset())
}

func (s *SettingsService) changed(settings preferences.Settings, err error) (preferences.Settings, error) {
	if err == nil && s.publish != nil {
		s.publish(settings)
	}
	return settings, err
}
