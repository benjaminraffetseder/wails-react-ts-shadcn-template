package main

import (
	"context"
	"errors"
	"fmt"
	"path/filepath"

	"{{.ModulePath}}/internal/apppaths"
	"{{.ModulePath}}/internal/items"

	"github.com/wailsapp/wails/v3/pkg/application"
)

// ItemsService opens its database and runs migrations on every native startup.
// React uses typed domain methods; SQL and paths stay in Go.
type ItemsService struct {
	store   items.Repository
	initErr error
	path    func() (string, error)
}

func NewItemsService() *ItemsService {
	return &ItemsService{path: func() (string, error) {
		dir, err := apppaths.DataDir()
		return filepath.Join(dir, "items.sqlite3"), err
	}}
}

func (s *ItemsService) ServiceStartup(_ context.Context, _ application.ServiceOptions) error {
	file, err := s.path()
	if err != nil {
		s.initErr = fmt.Errorf("items:initialization: %w", err)
	} else {
		store, err := items.Open(file)
		s.initErr = err
		if err == nil {
			s.store = store
		}
	}
	// Keep initialization/migration errors available to the example UI.
	return nil
}

func (s *ItemsService) ServiceShutdown() error {
	if s.store != nil {
		store := s.store
		s.store = nil
		return store.Close()
	}
	return nil
}

func (s *ItemsService) ready() error {
	if s.initErr != nil {
		return s.initErr
	}
	if s.store == nil {
		return errors.New("items:initialization: database is not open")
	}
	return nil
}

func (s *ItemsService) GetItems() ([]items.Item, error) {
	if err := s.ready(); err != nil {
		return nil, err
	}
	return s.store.List()
}
func (s *ItemsService) AddItem(title string) (items.Item, error) {
	if err := s.ready(); err != nil {
		return items.Item{}, err
	}
	return s.store.Add(title)
}
func (s *ItemsService) UpdateItem(id int64, title string, done bool) (items.Item, error) {
	if err := s.ready(); err != nil {
		return items.Item{}, err
	}
	return s.store.Update(id, title, done)
}
func (s *ItemsService) DeleteItem(id int64) error {
	if err := s.ready(); err != nil {
		return err
	}
	return s.store.Delete(id)
}
